{
  "name": "Baramundi \u2014 Critical CVE Report (26R1)",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Test Workflow",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Daily 06:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        460
      ]
    },
    {
      "parameters": {
        "bmsVersion": "26R1",
        "resource": "compliance",
        "operation": "getDetectedVulnerabilities",
        "returnAll": false,
        "limit": 500
      },
      "id": "get-vulns",
      "name": "Get All Detected Vulnerabilities",
      "type": "n8n-nodes-baramundi-management-suite.baramundiSecurity",
      "typeVersion": 1,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "bmsVersion": "26R1",
        "resource": "compliance",
        "operation": "getVulnerability",
        "vulnerabilityId": "={{ $json.vulnerabilityId || $json.id }}"
      },
      "id": "enrich-cve",
      "name": "Get CVE Details",
      "type": "n8n-nodes-baramundi-management-suite.baramundiSecurity",
      "typeVersion": 1,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Merge detection data (endpointId, endpointName, detected, ignored)\n// with CVE detail data (cvssScore, severity, description)\n// The CVE detail node replaces $json, so we need the paired input.\nconst detections = $('Get All Detected Vulnerabilities').all();\nconst details = $input.all();\n\nconst merged = details.map((detail, idx) => {\n  const det = detections[idx]?.json || {};\n  return {\n    json: {\n      ...det,\n      ...detail.json,\n      endpointId: det.endpointId || detail.json.endpointId,\n      endpointName: det.endpointName || detail.json.endpointName,\n      detected: det.detected || detail.json.detected,\n      ignored: det.ignored ?? detail.json.ignored,\n    }\n  };\n});\n\nreturn merged;"
      },
      "id": "merge-data",
      "name": "Merge Detection + CVE Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Filter to Critical severity or CVSS >= 9.0\nconst critical = $input.all().filter(i => {\n  const sev = (i.json.severity || '').toLowerCase();\n  const cvss = parseFloat(i.json.cvssScore) || 0;\n  return sev === 'critical' || cvss >= 9.0;\n});\n\nif (critical.length === 0) {\n  return [{ json: { hasCritical: false, summary: 'No critical CVEs detected.' } }];\n}\n\nreturn critical.map(i => ({ json: { ...i.json, hasCritical: true } }));"
      },
      "id": "filter-critical",
      "name": "Filter Critical (CVSS >= 9.0)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-critical",
              "leftValue": "={{ $json.hasCritical }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-critical",
      "name": "Any Critical?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1300,
        300
      ]
    },
    {
      "parameters": {
        "resource": "endpoint",
        "operation": "get",
        "endpointId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.endpointId }}"
        },
        "endpointType": "all"
      },
      "id": "enrich-endpoint",
      "name": "Get Endpoint Info",
      "type": "n8n-nodes-baramundi-management-suite.baramundiEndpoint",
      "typeVersion": 1,
      "position": [
        1520,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Merge endpoint info with CVE data from Filter Critical node\nconst endpoints = $input.all();\nconst cveItems = $('Filter Critical (CVSS >= 9.0)').all();\n\n// Build merged rows: CVE data + endpoint details\nconst rows = cveItems.map((cve, idx) => {\n  const ep = endpoints[idx]?.json || {};\n  return {\n    endpoint: ep.displayName || ep.hostName || cve.json.endpointName || '-',\n    os: ep.operatingSystem || '-',\n    primaryUser: ep.primaryUser || '-',\n    cve: cve.json.cveId || '-',\n    cvss: cve.json.cvssScore || '-',\n    severity: cve.json.severity || '-',\n    description: (cve.json.description || '').substring(0, 120),\n    detected: cve.json.detected || '-',\n    orgUnit: ep.orgUnit || '-',\n  };\n});\n\n// Sort by CVSS descending\nrows.sort((a, b) => (parseFloat(b.cvss) || 0) - (parseFloat(a.cvss) || 0));\n\nreturn [{ json: { report: rows, count: rows.length, generatedAt: new Date().toISOString() } }];"
      },
      "id": "build-report",
      "name": "Build Remediation Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1740,
        200
      ]
    },
    {
      "parameters": {},
      "id": "no-op",
      "name": "No Critical CVEs \u2014 Done",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1520,
        400
      ]
    }
  ],
  "connections": {
    "Test Workflow": {
      "main": [
        [
          {
            "node": "Get All Detected Vulnerabilities",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Daily 06:00": {
      "main": [
        [
          {
            "node": "Get All Detected Vulnerabilities",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get All Detected Vulnerabilities": {
      "main": [
        [
          {
            "node": "Get CVE Details",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get CVE Details": {
      "main": [
        [
          {
            "node": "Merge Detection + CVE Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Merge Detection + CVE Data": {
      "main": [
        [
          {
            "node": "Filter Critical (CVSS >= 9.0)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Critical (CVSS >= 9.0)": {
      "main": [
        [
          {
            "node": "Any Critical?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any Critical?": {
      "main": [
        [
          {
            "node": "Get Endpoint Info",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No Critical CVEs \u2014 Done",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Endpoint Info": {
      "main": [
        [
          {
            "node": "Build Remediation Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateId": "baramundi-critical-cves",
    "instanceId": ""
  }
}
